# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (Database + Auth + Storage)
# Create a project at https://supabase.com, then apply supabase/migrations
# with `supabase db push` (or paste them into the SQL editor in order).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Same as NEXT_PUBLIC_SUPABASE_URL; kept separate so server-only code never
# accidentally depends on a NEXT_PUBLIC_ var being present.
SUPABASE_URL=

# ---------------------------------------------------------------------------
# Encryption
# 32-byte key (hex or base64) used to encrypt integration credentials and
# OAuth tokens before they are stored. Generate with:
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# OpenAI (Realtime voice + post-call analysis + embeddings)
# Bootstraps the platform default; Super Admin can override from
# /super-admin/settings/apis without redeploying.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Twilio (Voice, phone numbers, Media Streams, recordings)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public base URL of THIS Next.js app, used to build Twilio webhook URLs
# (call status, recording callbacks). Must be reachable from the internet.
TWILIO_WEBHOOK_BASE_URL=http://localhost:3000

# Public base URL (wss://) of the realtime voice server (services/realtime-voice).
# Twilio's <Stream> connects here directly, bypassing Next's request/response
# cycle entirely.
REALTIME_WEBSOCKET_URL=ws://localhost:8080/media-stream

# Port the realtime voice server listens on.
REALTIME_VOICE_PORT=8080

# ---------------------------------------------------------------------------
# Google Calendar OAuth (appointment booking)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google-calendar/callback

# ---------------------------------------------------------------------------
# Queue / background workers (campaign dialer, post-call analysis, etc.)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Webhooks
# ---------------------------------------------------------------------------
WEBHOOK_SIGNING_SECRET=
